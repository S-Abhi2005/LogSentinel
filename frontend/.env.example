# LogSentinel Frontend Environment Configuration
# Frontend development server port (defaults to 5174 to avoid conflict with other apps on 5173)
VITE_PORT=5174

# Port and URL of the LogSentinel FastAPI backend service
VITE_BACKEND_PORT=8001
VITE_BACKEND_URL=http://localhost:8001

# Optional: Direct API base URL override (defaults to '/api/v1' via Vite dev proxy)
# VITE_API_BASE_URL=http://localhost:8001/api/v1
